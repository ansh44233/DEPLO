# Local app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Generate a unique secret with: openssl rand -base64 48
# Keep this server-side. Never use a NEXT_PUBLIC_ prefix.
DEPLO_UPLOAD_TOKEN=replace-with-a-random-secret-of-at-least-32-characters

# Optional private persistent directory outside the public web root.
DEPLO_UPLOAD_DIR=/var/lib/deplo/uploads

# Cloudflare Pages Direct Upload project settings
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-pages-write-token
CLOUDFLARE_PAGES_PROJECT_NAME=deplo-sites

# GitHub OAuth App (server-side only)
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# Encrypts the short-lived HttpOnly GitHub access-token cookie; generate a separate random secret.
GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-a-separate-random-secret-of-at-least-32-characters

# Public canonical URL of this DEPLO deployment
DEPLO_BASE_URL=http://localhost:3000

# Generate a separate random secret with: openssl rand -base64 48
DEPLO_SESSION_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters

# Supabase project database (server-side only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
