# DEPLO environment
# Copy to .env.local for local development (or set these in your host's dashboard).
# Generate every secret separately:  openssl rand -base64 48
# Never prefix any of these with NEXT_PUBLIC_ — they must stay server-side.

# ─── Required ──────────────────────────────────────────────────────────────

# Public URL of this DEPLO instance (no trailing slash)
DEPLO_BASE_URL=http://localhost:3000

# Signs session cookies (32+ characters)
DEPLO_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# GitHub OAuth App — callback URL: <DEPLO_BASE_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# Encrypts the HttpOnly GitHub token cookie (32+ characters, different from the session secret)
GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-a-separate-random-secret-of-at-least-32-characters

# Supabase project storage — run supabase/migrations/*.sql in order first.
# Use the secret key (sb_secret_...) or the legacy service_role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-server-only-key

# Cloudflare Pages hosting — API token needs the "Cloudflare Pages: Edit" permission
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-pages-edit-token

# ─── Background workers ────────────────────────────────────────────────────

# Vercel Cron sends this to the scheduled worker routes (see vercel.json)
CRON_SECRET=replace-with-another-random-secret-of-at-least-32-characters
# Bearer secrets for the queue worker endpoints
DEPLO_WEBHOOK_WORKER_SECRET=replace-with-another-random-secret-of-at-least-32-characters
DEPLO_BUILD_WORKER_SECRET=replace-with-another-random-secret-of-at-least-32-characters

# ─── Push-to-deploy and private repositories (optional) ────────────────────

# Must match the webhook secret configured on the GitHub App
DEPLO_GITHUB_WEBHOOK_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# GitHub App with Contents: Read-only and Metadata: Read-only
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM private key; multiline or escaped \n both work
GITHUB_APP_PRIVATE_KEY=

# ─── Framework builds (Vercel Sandbox) ─────────────────────────────────────
# On Vercel these are not needed: the Sandbox SDK authenticates with OIDC automatically.
# Elsewhere (local dev, your own server), provide an access token to enable builds:
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# Set to 1 to turn framework builds off entirely
DEPLO_DISABLE_SANDBOX_BUILDS=

# ─── Legacy shared-token upload API (persistent-disk hosts only) ───────────
# Not used on Vercel. Leave empty unless you call /api/uploads directly.
DEPLO_UPLOAD_TOKEN=
DEPLO_UPLOAD_DIR=
CLOUDFLARE_PAGES_PROJECT_NAME=

# ─── Self-hosted Firecracker build runner (advanced, optional) ─────────────
# Only for services/build-runner on a dedicated KVM host. See docs/BUILD_RUNNER.md.
DEPLO_BUILD_RUNNER_URL=
DEPLO_BUILD_RUNNER_TOKEN=
