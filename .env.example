# Local app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Generate a unique secret with: openssl rand -base64 48
# Keep this server-side. Never use a NEXT_PUBLIC_ prefix.
DEPLO_UPLOAD_TOKEN=replace-with-a-random-secret-of-at-least-32-characters

# Optional private persistent directory outside the public web root.
DEPLO_UPLOAD_DIR=/var/lib/deplo/uploads
